# Supabase dashboard → Connect → "Transaction pooler" connection string (port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# The service_role / secret key. Server-side only: never put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: storage bucket name (created automatically)
# SUPABASE_BUCKET=attachments
